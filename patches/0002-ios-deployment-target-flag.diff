 # -------------------------------------------------------------------------------
 # Apple cross-platform device build config
 if(WITH_APPLE_CROSSPLATFORM)
+  # CMake configured as Darwin adds -mmacosx-version-min, which clang rejects next to
+  # -miphoneos-version-min: emit the iOS form for the deployment target instead.
+  foreach(_lang C CXX OBJC OBJCXX)
+    set(CMAKE_${_lang}_OSX_DEPLOYMENT_TARGET_FLAG "-miphoneos-version-min=")
+  endforeach()
   # Disable modules with no planned/required support on iOS.
   set(WITH_USD OFF CACHE BOOL "Disable until we fix issue with release build" FORCE)
   set(NO_PLATFORM_SUPPORT_MSG "Auto disabled as APPLE_TARGET_DEVICE=ios")
