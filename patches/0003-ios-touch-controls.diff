+- (void)addButton:(NSString*)label at:(CGPoint)c radius:(CGFloat)r button:(SDL_GamepadButton)b trigger:(int)t {
+    PTPadButton* p = [PTPadButton new];
+    p.frame = CGRectMake(c.x - r, c.y - r, 2 * r, 2 * r);
+    p.label = label;
+    p.button = b;
+    p.trigger = t;
+    [_buttons addObject:p];
+}
+
+- (void)layoutSubviews {
+    [super layoutSubviews];
+    [self releaseAll];
+    [_buttons removeAllObjects];
+    const CGSize s = self.bounds.size;
+    const UIEdgeInsets inset = self.safeAreaInsets;
+    const CGFloat unit = std::fmin(s.width, s.height) / 9.0;
+    const CGFloat r = unit * 0.55;
+    /* face buttons, PlayStation layout, bottom right */
+    const CGPoint face = CGPointMake(s.width - inset.right - unit * 2.0, s.height - inset.bottom - unit * 2.2);
+    [self addButton:@"✕" at:CGPointMake(face.x, face.y + unit) radius:r button:SDL_GAMEPAD_BUTTON_SOUTH trigger:0];
+    [self addButton:@"○" at:CGPointMake(face.x + unit, face.y) radius:r button:SDL_GAMEPAD_BUTTON_EAST trigger:0];
+    [self addButton:@"□" at:CGPointMake(face.x - unit, face.y) radius:r button:SDL_GAMEPAD_BUTTON_WEST trigger:0];
+    [self addButton:@"△" at:CGPointMake(face.x, face.y - unit) radius:r button:SDL_GAMEPAD_BUTTON_NORTH trigger:0];
+    /* shoulders and triggers in the top corners */
+    const CGFloat top = inset.top + unit * 0.9;
+    [self addButton:@"L2" at:CGPointMake(inset.left + unit * 0.9, top) radius:r button:SDL_GAMEPAD_BUTTON_INVALID trigger:1];
+    [self addButton:@"L1" at:CGPointMake(inset.left + unit * 2.2, top) radius:r button:SDL_GAMEPAD_BUTTON_LEFT_SHOULDER trigger:0];
+    [self addButton:@"R1" at:CGPointMake(s.width - inset.right - unit * 2.2, top) radius:r button:SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER trigger:0];
+    [self addButton:@"R2" at:CGPointMake(s.width - inset.right - unit * 0.9, top) radius:r button:SDL_GAMEPAD_BUTTON_INVALID trigger:2];
+    /* options in the middle at the top */
+    [self addButton:@"≡" at:CGPointMake(s.width * 0.5 + unit * 0.8, top) radius:r * 0.8 button:SDL_GAMEPAD_BUTTON_START trigger:0];
+    [self addButton:@"L3" at:CGPointMake(inset.left + unit * 0.9, s.height - inset.bottom - unit * 0.8) radius:r * 0.8 button:SDL_GAMEPAD_BUTTON_LEFT_STICK trigger:0];
+    [self addButton:@"R3" at:CGPointMake(face.x - unit * 2.3, s.height - inset.bottom - unit * 0.8) radius:r * 0.8 button:SDL_GAMEPAD_BUTTON_RIGHT_STICK trigger:0];
+    const CGFloat bw = std::fmax(unit * 1.5, 64.0), by = top - 14;
+    _split.frame = CGRectMake(s.width * 0.5 - bw * 1.6 - 6, by, bw * 1.6, 28);
+    _toggle.frame = CGRectMake(s.width * 0.5 - bw - 6 - bw * 1.6 - 6, by, bw, 28);
+    _flip.frame = CGRectMake(s.width * 0.5 + unit * 0.8 + r + 8, by, bw, 28);
+    _toggle.hidden = _splitMode;
+    [self setNeedsDisplay];
+}
+
+- (CGFloat)stickRadius {
+    return std::fmin(self.bounds.size.width, self.bounds.size.height) / 9.0 * 1.2;
+}
+
+- (void)updateStick:(PTStick*)stick {
+    const CGFloat R = [self stickRadius];
+    CGFloat dx = stick.knob.x - stick.origin.x, dy = stick.knob.y - stick.origin.y;
+    const CGFloat len = std::sqrt(dx * dx + dy * dy);
+    if (len > R) {
+        dx *= R / len;
+        dy *= R / len;
+    }
+    SetAxis(stick.axis_x, dx / R);
+    SetAxis(stick.axis_y, dy / R);
+}
+
+- (void)press:(PTPadButton*)b down:(BOOL)down {
+    b.down = down;
+    if (b.trigger == 1) SetAxis(SDL_GAMEPAD_AXIS_LEFT_TRIGGER, down ? 1.0f : 0.0f);
+    else if (b.trigger == 2) SetAxis(SDL_GAMEPAD_AXIS_RIGHT_TRIGGER, down ? 1.0f : 0.0f);
+    else SetButton(b.button, down);
+}
+
+- (PTPadButton*)buttonAt:(CGPoint)p {
+    for (PTPadButton* b in _buttons) {
+        if (CGRectContainsPoint(CGRectInset(b.frame, -6, -6), p)) return b;
+    }
+    return nil;
+}
+
+- (void)touchesBegan:(NSSet<UITouch*>*)touches withEvent:(UIEvent*)event {
+    if (_hidden_by_user) return;
+    for (UITouch* t in touches) {
+        const CGPoint p = [t locationInView:self];
+        if (PTPadButton* b = [self buttonAt:p]) {
+            _held[[NSValue valueWithNonretainedObject:t]] = b;
+            [self press:b down:YES];
+        } else if (p.x < self.bounds.size.width * 0.5 && !_move.touch) {
+            _move.touch = t;
+            _move.origin = _move.knob = p;
+            _move.began = t.timestamp;
+        } else if (p.x >= self.bounds.size.width * 0.5 && !_look.touch) {
+            _look.touch = t;
+            _look.origin = _look.knob = p;
+            _look.began = t.timestamp;
+        }
+    }
+    [self setNeedsDisplay];
+}
+
+- (void)touchesMoved:(NSSet<UITouch*>*)touches withEvent:(UIEvent*)event {
+    for (UITouch* t in touches) {
+        const CGPoint p = [t locationInView:self];
+        if (t == _move.touch) {
+            _move.knob = p;
+            [self updateStick:_move];
+        } else if (t == _look.touch) {
+            _look.knob = p;
+            [self updateStick:_look];
+        } else {
+            /* slide between buttons */
+            NSValue* key = [NSValue valueWithNonretainedObject:t];
+            PTPadButton* old = _held[key];
+            PTPadButton* now = [self buttonAt:p];
+            if (old != now) {
+                if (old) [self press:old down:NO];
+                if (now) [self press:now down:YES];
+                if (now) _held[key] = now;
+                else [_held removeObjectForKey:key];
+            }
+        }
+    }
+    [self setNeedsDisplay];
+}
+
+/* A quick tap on the stick areas; two in a row show or hide the controls (they keep working while hidden). */
+- (void)noteTapFor:(PTStick*)stick touch:(UITouch*)t {
+    const CGPoint p = [t locationInView:self];
+    const CGFloat moved = std::hypot(p.x - stick.origin.x, p.y - stick.origin.y);
+    if (t.timestamp - stick.began > 0.25 || moved > 15) return;
+    if (t.timestamp - _last_tap < 0.35) {
+        _ghost = !_ghost;
+        _last_tap = 0;
+        [self setNeedsDisplay];
+    } else {
+        _last_tap = t.timestamp;
+    }
+}
+
+- (void)endTouches:(NSSet<UITouch*>*)touches {
+    for (UITouch* t in touches) {
+        if (t == _move.touch) [self noteTapFor:_move touch:t];
+        else if (t == _look.touch) [self noteTapFor:_look touch:t];
+        if (t == _move.touch) {
+            _move.touch = nil;
+            SetAxis(SDL_GAMEPAD_AXIS_LEFTX, 0);
+            SetAxis(SDL_GAMEPAD_AXIS_LEFTY, 0);
+        } else if (t == _look.touch) {
+            _look.touch = nil;
+            SetAxis(SDL_GAMEPAD_AXIS_RIGHTX, 0);
+            SetAxis(SDL_GAMEPAD_AXIS_RIGHTY, 0);
+        } else {
+            NSValue* key = [NSValue valueWithNonretainedObject:t];
+            if (PTPadButton* b = _held[key]) [self press:b down:NO];
+            [_held removeObjectForKey:key];
+        }
+    }
+    [self setNeedsDisplay];
+}
+
+- (void)touchesEnded:(NSSet<UITouch*>*)touches withEvent:(UIEvent*)event { [self endTouches:touches]; }
+- (void)touchesCancelled:(NSSet<UITouch*>*)touches withEvent:(UIEvent*)event { [self endTouches:touches]; }
+
+- (void)releaseAll {
+    for (PTPadButton* b in _buttons) {
+        if (b.down) [self press:b down:NO];
+    }
+    [_held removeAllObjects];
+    _move.touch = nil;
+    _look.touch = nil;
+    for (SDL_GamepadAxis a : {SDL_GAMEPAD_AXIS_LEFTX, SDL_GAMEPAD_AXIS_LEFTY, SDL_GAMEPAD_AXIS_RIGHTX, SDL_GAMEPAD_AXIS_RIGHTY}) SetAxis(a, 0);
+}
+
+- (void)drawRect:(CGRect)rect {
+    if (_hidden_by_user || _ghost) return;
+    UIColor* fill = [UIColor colorWithWhite:1 alpha:0.10];
+    UIColor* pressed = [UIColor colorWithWhite:1 alpha:0.30];
+    UIColor* edge = [UIColor colorWithWhite:1 alpha:0.35];
+    for (PTPadButton* b in _buttons) {
+        UIBezierPath* circle = [UIBezierPath bezierPathWithOvalInRect:b.frame];
+        [(b.down ? pressed : fill) setFill];
+        [circle fill];
+        [edge setStroke];
+        circle.lineWidth = 1.5;
+        [circle stroke];
+        NSDictionary* attrs = @{NSFontAttributeName : [UIFont boldSystemFontOfSize:b.frame.size.height * 0.38],
+                                NSForegroundColorAttributeName : [UIColor colorWithWhite:1 alpha:0.7]};
+        const CGSize ts = [b.label sizeWithAttributes:attrs];
+        [b.label drawAtPoint:CGPointMake(CGRectGetMidX(b.frame) - ts.width / 2, CGRectGetMidY(b.frame) - ts.height / 2) withAttributes:attrs];
+    }
+    const CGFloat R = [self stickRadius];
+    for (PTStick* s in @[ _move, _look ]) {
+        if (!s.touch) continue;
+        UIBezierPath* base = [UIBezierPath bezierPathWithOvalInRect:CGRectMake(s.origin.x - R, s.origin.y - R, 2 * R, 2 * R)];
+        [fill setFill];
+        [base fill];
+        [edge setStroke];
+        [base stroke];
+        CGFloat dx = s.knob.x - s.origin.x, dy = s.knob.y - s.origin.y;
+        const CGFloat len = std::sqrt(dx * dx + dy * dy);
+        if (len > R) {
+            dx *= R / len;
+            dy *= R / len;
+        }
+        const CGFloat k = R * 0.45;
+        UIBezierPath* knob = [UIBezierPath bezierPathWithOvalInRect:CGRectMake(s.origin.x + dx - k, s.origin.y + dy - k, 2 * k, 2 * k)];
+        [pressed setFill];
+        [knob fill];
+    }
+}
+
+/* Touches outside the controls still reach the game only when the pad is hidden. */
+- (UIView*)hitTest:(CGPoint)point withEvent:(UIEvent*)event {
+    UIView* hit = [super hitTest:point withEvent:event];
+    if (hit == _toggle || hit == _flip || hit == _split) return hit;
+    return _hidden_by_user ? nil : hit;
+}
+
+@end
+
+/* The controls live in a window of their own above SDL's: SDL swaps its view controller's view when it makes the Metal
+   view, which would take an overlay inside it away. Touches the controls don't use fall through to the game window. */
+@interface PTPadWindow : UIWindow
+@end
+@implementation PTPadWindow
+- (UIView*)hitTest:(CGPoint)point withEvent:(UIEvent*)event {
+    UIView* hit = [super hitTest:point withEvent:event];
+    return (hit == self || hit == self.rootViewController.view.superview) ? nil : hit;
+}
+@end
+
+@interface PTPadController : UIViewController
+@property(nonatomic, strong) PTTouchPadView* pad;
+@end
+@implementation PTPadController
+- (void)loadView {
+    self.view = self.pad;
+}
+- (BOOL)prefersStatusBarHidden { return YES; }
+- (BOOL)prefersHomeIndicatorAutoHidden { return YES; }
+@end
+
+/* iPhone Duo: the game on one half, the controller on the other. The split follows the crease that iOS reports (top and
+   bottom in the laptop pose, left and right in the book pose); Flip swaps the halves. Split: Auto splits while the phone
+   is partly folded, On always, Off never. The game's window is resized to its half, so it renders at that size. */
+@implementation PTDuoLayout {
+    __weak UIWindow* _game;
+    PTPadWindow* _controls;
+    __weak PTTouchPadView* _pad;
+    __weak UIView* _hinge_view;
+    id _hinge;
+    NSInteger _hinge_status; /* UIHingeStatus: 0 unknown, 1 closed, 2 partly open, 3 open */
+    int _mode;               /* 0 auto, 1 on, 2 off */
+    BOOL _flipped;
+    NSTimer* _timer;
+}
+
++ (instancetype)shared {
+    static PTDuoLayout* layout = [PTDuoLayout new];
+    return layout;
+}
+
+- (void)attachGame:(UIWindow*)game controls:(PTPadWindow*)controls pad:(PTTouchPadView*)pad {
+    _game = game;
+    _controls = controls;
+    _pad = pad;
+    _timer = [NSTimer scheduledTimerWithTimeInterval:0.25 target:self selector:@selector(apply) userInfo:nil repeats:YES];
+    [self apply];
+}
+
+- (void)flip {
+    _flipped = !_flipped;
+    [self apply];
+}
+
+- (void)cycleSplit {
+    _mode = (_mode + 1) % 3;
+    [_pad setSplitTitle:@[ @"Split: Auto", @"Split: On", @"Split: Off" ][_mode]];
+    [self apply];
+}
+
+/* hinge updates come through an interaction on a view; the controls' view stays put, unlike SDL's */
+- (void)watchHinge:(UIView*)view {
+    if (_hinge_view == view) return;
+    if (@available(iOS 27.1, *)) {
+        if (_hinge && _hinge_view) [_hinge_view removeInteraction:_hinge];
+        UIHingeInteraction* hinge = [[UIHingeInteraction alloc] initWithUpdateHandler:^(UIHingeInteraction*, UIHingeInteractionUpdate* update) {
+            PTDuoLayout* me = [PTDuoLayout shared];
+            const NSInteger status = update.hinge ? update.hinge.status : 0;
+            if (status != me->_hinge_status) {
+                me->_hinge_status = status;
+                pt::LogInfo("iPhone Duo: hinge {}", static_cast<int>(status));
+                [me apply];
+            }
+        }];
+        [view addInteraction:hinge];
+        _hinge = hinge;
+        _hinge_view = view;
+    }
+}
+
+/* The crease in the scene's coordinates, or CGRectNull */
+- (CGRect)creaseIn:(UIWindowScene*)scene view:(UIView*)view {
+    if (@available(iOS 27.1, *)) {
+        NSArray<UIViewReservedRegion*>* regions = [view reservedRegionsOfKind:[UIViewReservedRegionKind divisionRegionKind]
+                                                                      options:UIViewReservedRegionQueryOptionsIncludeInactive];
+        for (UIViewReservedRegion* region in regions) {
+            const CGRect f = region.frame;
+            const UIEdgeInsets m = region.margins;
+            const CGRect r = CGRectMake(f.origin.x + m.left, f.origin.y + m.top, f.size.width - m.left - m.right, f.size.height - m.top - m.bottom);
+            return [view convertRect:r toCoordinateSpace:scene.coordinateSpace];
+        }
+    }
+    return CGRectNull;
+}
+
+- (void)apply {
+    UIWindow* game = _game;
+    PTPadWindow* controls = _controls;
+    PTTouchPadView* pad = _pad;
+    UIWindowScene* scene = game.windowScene;
+    if (!game || !controls || !pad || !scene) return;
+    [self watchHinge:pad];
+    const CGRect bounds = scene.coordinateSpace.bounds;
+    const BOOL split = _mode == 1 || (_mode == 0 && _hinge_status == 2);
+    CGRect game_rect = bounds, pad_rect = bounds;
+    if (split) {
+        /* the controls' window is full size while not split, so ask it for the crease before it shrinks */
+        CGRect crease = [self creaseIn:scene view:game];
+        BOOL across;
+        if (CGRectIsNull(crease) || CGRectIsEmpty(crease)) {
+            across = bounds.size.height >= bounds.size.width;
+            crease = across ? CGRectMake(0, CGRectGetMidY(bounds), bounds.size.width, 0) : CGRectMake(CGRectGetMidX(bounds), 0, 0, bounds.size.height);
+        } else {
+            across = crease.size.width >= crease.size.height;
+        }
+        CGRect first, second;
+        if (across) {
+            first = CGRectMake(0, 0, bounds.size.width, CGRectGetMinY(crease));
+            second = CGRectMake(0, CGRectGetMaxY(crease), bounds.size.width, bounds.size.height - CGRectGetMaxY(crease));
+        } else {
+            first = CGRectMake(0, 0, CGRectGetMinX(crease), bounds.size.height);
+            second = CGRectMake(CGRectGetMaxX(crease), 0, bounds.size.width - CGRectGetMaxX(crease), bounds.size.height);
+        }
+        game_rect = _flipped ? second : first;
+        pad_rect = _flipped ? first : second;
+    }
+    if (pad.splitMode != split) pad.splitMode = split;
+    if (!CGRectEqualToRect(controls.frame, pad_rect)) controls.frame = pad_rect;
+    if (!CGRectEqualToRect(game.frame, game_rect)) {
+        game.frame = game_rect;
+        [game.rootViewController.view setNeedsLayout];
+        pt::LogInfo("iPhone Duo: game {}x{} at {},{}; controls {}x{} at {},{}{}", game_rect.size.width, game_rect.size.height,
+                    game_rect.origin.x, game_rect.origin.y, pad_rect.size.width, pad_rect.size.height, pad_rect.origin.x,
+                    pad_rect.origin.y, split ? " (split)" : "");
+    }
+}
+
+@end
+
+namespace pt::ios {
+
+void AttachTouchPad(SDL_Window* window) {
+    SDL_SetHint(SDL_HINT_TOUCH_MOUSE_EVENTS, "0");
+    if (!g_pad) {
+        SDL_VirtualJoystickDesc desc;
+        SDL_INIT_INTERFACE(&desc);
+        desc.type = SDL_JOYSTICK_TYPE_GAMEPAD;
+        desc.naxes = SDL_GAMEPAD_AXIS_COUNT;
+        desc.nbuttons = SDL_GAMEPAD_BUTTON_COUNT;
+        desc.axis_mask = (1u << SDL_GAMEPAD_AXIS_COUNT) - 1u;
+        desc.button_mask = (1u << SDL_GAMEPAD_BUTTON_COUNT) - 1u;
+        desc.name = "Touch controls";
+        const SDL_JoystickID id = SDL_AttachVirtualJoystick(&desc);
+        if (id) g_pad = SDL_OpenJoystick(id);
+        if (!g_pad) LogError("touch controls: no virtual gamepad ({})", SDL_GetError());
+        else {
+            SetAxis(SDL_GAMEPAD_AXIS_LEFT_TRIGGER, 0);
+            SetAxis(SDL_GAMEPAD_AXIS_RIGHT_TRIGGER, 0);
+        }
+    }
+    UIWindow* game = (__bridge UIWindow*)SDL_GetPointerProperty(SDL_GetWindowProperties(window), SDL_PROP_WINDOW_UIKIT_WINDOW_POINTER, nullptr);
+    if (!game || !game.windowScene) {
+        LogError("touch controls: no UIKit window");
+        return;
+    }
+    PTTouchPadView* pad = [[PTTouchPadView alloc] initWithFrame:game.windowScene.coordinateSpace.bounds];
+    PTPadController* controller = [PTPadController new];
+    controller.pad = pad;
+    PTPadWindow* controls = [[PTPadWindow alloc] initWithWindowScene:game.windowScene];
+    controls.windowLevel = UIWindowLevelNormal + 1;
+    controls.backgroundColor = UIColor.clearColor;
+    controls.rootViewController = controller;
+    controls.frame = game.windowScene.coordinateSpace.bounds;
+    controls.hidden = NO;
+    [[PTDuoLayout shared] attachGame:game controls:controls pad:pad];
+    LogInfo("touch controls: attached");
+}
+
+}  // namespace pt::ios
