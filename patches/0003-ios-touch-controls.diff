+SDL_Joystick* g_pad = nullptr;
+
+void SetButton(SDL_GamepadButton b, bool down) {
+    if (g_pad) SDL_SetJoystickVirtualButton(g_pad, b, down);
+}
+
+void SetAxis(SDL_GamepadAxis a, float v) {
+    if (!g_pad) return;
+    v = std::fmax(-1.0f, std::fmin(1.0f, v));
+    SDL_SetJoystickVirtualAxis(g_pad, a, static_cast<Sint16>(v * 32767.0f));
+}
