+/* One round button. */
+@interface PTPadButton : NSObject
+@property(nonatomic) CGRect frame;
+@property(nonatomic, copy) NSString* label;
+@property(nonatomic) SDL_GamepadButton button;
+@property(nonatomic) int trigger; /* 0: a button, 1: left trigger, 2: right trigger */
+@property(nonatomic) BOOL down;
+@end
+@implementation PTPadButton
+@end
+
+/* A floating stick: appears where the finger lands, deflects as it moves. */
+@interface PTStick : NSObject
+@property(nonatomic) UITouch* touch;
+@property(nonatomic) CGPoint origin;
+@property(nonatomic) CGPoint knob;
+@property(nonatomic) SDL_GamepadAxis axis_x;
+@property(nonatomic) SDL_GamepadAxis axis_y;
+@property(nonatomic) NSTimeInterval began;
+@end
+@implementation PTStick
+@end
