+@interface PTTouchPadView : UIView
+/* YES while the pad has its own half of the screen (iPhone Duo split): drawn as a controller surface */
+@property(nonatomic) BOOL splitMode;
+- (void)setSplitTitle:(NSString*)title;
+@end
+
+@interface PTDuoLayout : NSObject
++ (instancetype)shared;
+- (void)flip;
+- (void)cycleSplit;
+@end
+
+@implementation PTTouchPadView {
+    NSMutableArray<PTPadButton*>* _buttons;
+    NSMutableDictionary<NSValue*, PTPadButton*>* _held;
+    PTStick* _move;
+    PTStick* _look;
+    UIButton* _toggle;
+    UIButton* _flip;
+    UIButton* _split;
+    BOOL _hidden_by_user;
+    BOOL _ghost;              /* double tap: controls still work but are not drawn */
+    NSTimeInterval _last_tap;
+}
+
+@synthesize splitMode = _splitMode;
+
+- (instancetype)initWithFrame:(CGRect)frame {
+    self = [super initWithFrame:frame];
+    self.backgroundColor = UIColor.clearColor;
+    self.multipleTouchEnabled = YES;
+    self.opaque = NO;
+    self.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
+    _buttons = [NSMutableArray array];
+    _held = [NSMutableDictionary dictionary];
+    _move = [PTStick new];
+    _move.axis_x = SDL_GAMEPAD_AXIS_LEFTX;
+    _move.axis_y = SDL_GAMEPAD_AXIS_LEFTY;
+    _look = [PTStick new];
+    _look.axis_x = SDL_GAMEPAD_AXIS_RIGHTX;
+    _look.axis_y = SDL_GAMEPAD_AXIS_RIGHTY;
+
+    _toggle = [UIButton buttonWithType:UIButtonTypeSystem];
+    [_toggle setTitle:@"Hide" forState:UIControlStateNormal];
+    _toggle.titleLabel.font = [UIFont boldSystemFontOfSize:12];
+    _toggle.tintColor = [UIColor colorWithWhite:1 alpha:0.6];
+    _toggle.backgroundColor = [UIColor colorWithWhite:0 alpha:0.25];
+    _toggle.layer.cornerRadius = 8;
+    [_toggle addTarget:self action:@selector(toggle) forControlEvents:UIControlEventTouchUpInside];
+    [self addSubview:_toggle];
+    _flip = [self barButton:@"Flip" action:@selector(flipHalves)];
+    _split = [self barButton:@"Split: Auto" action:@selector(cycleSplit)];
+
+    [[NSNotificationCenter defaultCenter] addObserver:self selector:@selector(controllersChanged) name:GCControllerDidConnectNotification object:nil];
+    [[NSNotificationCenter defaultCenter] addObserver:self selector:@selector(controllersChanged) name:GCControllerDidDisconnectNotification object:nil];
+    [self controllersChanged];
+    return self;
+}
+
+- (UIButton*)barButton:(NSString*)title action:(SEL)action {
+    UIButton* b = [UIButton buttonWithType:UIButtonTypeSystem];
+    [b setTitle:title forState:UIControlStateNormal];
+    b.titleLabel.font = [UIFont boldSystemFontOfSize:12];
+    b.tintColor = [UIColor colorWithWhite:1 alpha:0.6];
+    b.backgroundColor = [UIColor colorWithWhite:0 alpha:0.25];
+    b.layer.cornerRadius = 8;
+    [b addTarget:self action:action forControlEvents:UIControlEventTouchUpInside];
+    [self addSubview:b];
+    return b;
+}
+
+- (void)flipHalves { [[PTDuoLayout shared] flip]; }
+- (void)cycleSplit { [[PTDuoLayout shared] cycleSplit]; }
+- (void)setSplitTitle:(NSString*)title { [_split setTitle:title forState:UIControlStateNormal]; }
+
+- (void)setSplitMode:(BOOL)split {
+    _splitMode = split;
+    self.backgroundColor = split ? [UIColor colorWithRed:0.07 green:0.07 blue:0.08 alpha:1] : UIColor.clearColor;
+    _flip.hidden = !split;
+    [self setNeedsLayout];
+}
+
+- (void)toggle {
+    _hidden_by_user = !_hidden_by_user;
+    [_toggle setTitle:_hidden_by_user ? @"Pad" : @"Hide" forState:UIControlStateNormal];
+    [self releaseAll];
+    [self setNeedsDisplay];
+}
+
+- (void)controllersChanged {
+    BOOL real = NO;
+    for (GCController* c in GCController.controllers) {
+        if (c.extendedGamepad) real = YES;
+    }
+    if (real != self.hidden) {
+        [self releaseAll];
+        self.hidden = real;
+    }
+}
