diff --git a/intern/ghost/intern/GHOST_WindowIOS.mm b/intern/ghost/intern/GHOST_WindowIOS.mm
index e5c35178..924852c8 100644
--- a/intern/ghost/intern/GHOST_WindowIOS.mm
+++ b/intern/ghost/intern/GHOST_WindowIOS.mm
@@ -649,13 +649,19 @@ typedef struct UserInputEvent {
     return;
   }
 
-  CGPoint touch_point = [sender locationInView:window->getView()];
-  CGFloat scale = [window->getView() contentScaleFactor];
-  touch_point.x *= scale;
-  touch_point.y *= scale;
-
-  system->pushEvent(new GHOST_Event(
-      GHOST_GetMilliSeconds((GHOST_SystemHandle)system), GHOST_kEventTwoFingerTap, window));
+  /* Two-finger tap = right click (context menus), at the point between the two fingers. */
+  CGPoint touch_point = [sender getScaledTouchPoint:window];
+  const uint64_t now = GHOST_GetMilliSeconds((GHOST_SystemHandle)system);
+  system->pushEvent(new GHOST_EventCursor(now,
+                                          GHOST_kEventCursorMove,
+                                          window,
+                                          touch_point.x,
+                                          touch_point.y,
+                                          GHOST_TABLET_DATA_NONE));
+  system->pushEvent(new GHOST_EventButton(
+      now, GHOST_kEventButtonDown, window, GHOST_kButtonMaskRight, GHOST_TABLET_DATA_NONE));
+  system->pushEvent(new GHOST_EventButton(
+      now, GHOST_kEventButtonUp, window, GHOST_kButtonMaskRight, GHOST_TABLET_DATA_NONE));
 }
 
 - (void)handleTap3F:(GHOSTUITapGestureRecognizer *)sender
